# ==============================================================================
# Sunset Group Customer Application Platform — Environment Configuration
# Copy this file to .env and fill in all required values before running.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_NAME="Sunset Customer Application Platform"
APP_VERSION="1.0.0"
# Set to true to enable debug mode (never use in production!)
DEBUG=false
# Strong random secret used for misc signing; generate with: openssl rand -hex 32
SECRET_KEY=changeme_generate_a_strong_random_secret
# Options: development | staging | production
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/sunsetcustomer
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# JWT / Authentication
# ------------------------------------------------------------------------------
# Independent secret for JWT signing; generate with: openssl rand -hex 32
JWT_SECRET_KEY=changeme_generate_a_strong_jwt_secret
JWT_ALGORITHM=HS256
# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# OTP Settings
# ------------------------------------------------------------------------------
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MINUTES=2

# ------------------------------------------------------------------------------
# AWS S3 / Object Storage
# ------------------------------------------------------------------------------
S3_BUCKET_NAME=sunset-customer-docs
S3_ACCESS_KEY_ID=your_aws_access_key_id
S3_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_REGION=ap-southeast-1
# Leave empty to use the default AWS S3 endpoint; set for MinIO or other S3-compatible stores
S3_ENDPOINT_URL=
# How long (seconds) pre-signed download URLs remain valid
S3_SIGNED_URL_EXPIRE_SECONDS=3600

# ------------------------------------------------------------------------------
# File Upload Limits
# ------------------------------------------------------------------------------
# Maximum allowed upload size in megabytes
MAX_FILE_SIZE_MB=10
# Comma-separated MIME types accepted for image uploads
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]
# Comma-separated MIME types accepted for document uploads
ALLOWED_DOC_TYPES=["application/pdf","image/jpeg","image/png"]

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
# JSON array of allowed origins (front-end URLs)
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
# Stricter limit for auth endpoints (login, OTP, etc.)
AUTH_RATE_LIMIT_PER_MINUTE=10

# ------------------------------------------------------------------------------
# Redis (used by SlowAPI for rate-limit counters)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Email / SMTP
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@sunsetgroup.com

# ------------------------------------------------------------------------------
# SMS Gateway
# ------------------------------------------------------------------------------
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=SUNSET

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
